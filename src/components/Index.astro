---
import { packageLink } from "@scripts/pages";
import SubDomainsAstroComponent from "./Links/SubDomains.astro";
import subdomains from "@data/subdomains.json";
---

<article>
    <div class="part">
        <h2>Hi!</h2>
    </div>

    <div class="part">
        <h2>Quick links</h2>
        <ul>
            {
                Object.entries(subdomains).map(([url, desc]) => {
                    const title = url.slice(0, url.indexOf("."))
                    return (
                        <li>
                            <a class="onelink" href={url} target="_blank" title={url}>
                                <p>
                                    <span class="links-url">{title}</span>
                                    {desc && (
                                        <span> - </span>
                                        <span>{desc.toLowerCase()}</span>
                                    )}
                                </p>
                            </a>
                        </li>
                    )
                })
            }
        </ul>
    </div>
    <div class="part center">
        <h2>Thanks for watching</h2>
    </div>
</article>

<style>
    .onelink {
        display: block;
    }
    .onelink:hover {
        text-decoration: underline;
    }
    li {
        width: max-content;
    }
    .links-url {
        color: blue;
        font-weight: bold;
    }
    h2:hover::before {
        transform: scaleX(1);
        transform-origin: bottom left;
    }
    details summary {
        cursor: pointer;
    }
    details[open] summary {
        display: none;
    }
    h2::before {
        content: " ";
        transform: scaleX(0);
        transform-origin: bottom right;
        display: block;
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        inset: 0 0 0 0;
        background: var(--globalColor);
        z-index: -1;
        transition: transform 0.3s ease;
    }
    h2 {
        width: max-content;
        position: relative;
    }

    .center {
        text-align: center;
    }
</style>
